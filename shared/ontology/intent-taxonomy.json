{
  "schemaVersion": "0.1",
  "concepts": {
    "primary_action": {
      "definition": "当前局部决策上下文中，最希望用户采取的动作。",
      "allowedComponents": ["antd.button"],
      "preferredVariants": { "antd.button": { "intent": "primary" } },
      "relatedPatterns": ["admin-user-permissions", "destructive-confirmation"],
      "rules": ["max_one_per_action_group", "must_have_clear_verb_first_label", "must_not_be_used_for_navigation"],
      "riskLevel": "low"
    },
    "secondary_action": {
      "definition": "支持主路径、但不应在视觉上与主 CTA 竞争的动作。",
      "allowedComponents": ["antd.button"],
      "preferredVariants": { "antd.button": { "intent": "default" } },
      "rules": ["should_not_outnumber_primary_in_group"]
    },
    "destructive_action": {
      "definition": "删除、撤销、移除或造成不可逆/高风险变化的动作。",
      "allowedComponents": ["antd.button"],
      "preferredVariants": { "antd.button": { "intent": "danger" } },
      "relatedPatterns": ["destructive-confirmation"],
      "rules": ["requires_confirmation_if_high_risk", "must_use_danger_variant", "must_not_be_default_primary_in_non_destructive_context"],
      "riskLevel": "high"
    },
    "destructive_confirmation": {
      "definition": "破坏性操作执行前，阻断式要求用户二次确认的交互。",
      "allowedComponents": ["antd.modal", "antd.button"],
      "preferredVariants": { "antd.modal": { "intent": "confirm" }, "antd.button": { "intent": "danger" } },
      "rules": ["confirm_modal_must_contain_explicit_action_verb", "primary_confirm_must_reflect_severity"],
      "riskLevel": "high"
    },
    "navigation": {
      "definition": "在信息架构间移动（页面/视图/锚点），非触发业务动作。",
      "allowedComponents": ["antd.menu", "antd.breadcrumb"],
      "rules": ["must_not_use_button_for_pure_navigation_when_link_suffices"]
    },
    "data_management": {
      "definition": "浏览/操作一批同构记录（表格、列表）。",
      "allowedComponents": ["antd.table", "antd.tag", "antd.badge"],
      "relatedPatterns": ["table-with-filters", "admin-user-permissions"],
      "rules": ["prefer_table_for_dense_homogeneous_records", "must_have_empty_state", "destructive_row_actions_need_confirmation"]
    },
    "data_entry": {
      "definition": "用户输入结构化数据。",
      "allowedComponents": ["antd.form", "antd.input", "antd.select", "antd.switch"],
      "rules": ["required_fields_marked", "validation_feedback_required", "submit_button_at_form_bottom"]
    },
    "filtering": {
      "definition": "缩小数据集合的范围操作（搜索/筛选/排序）。",
      "allowedComponents": ["antd.input", "antd.select"],
      "relatedPatterns": ["table-with-filters"],
      "rules": ["filters_grouped_before_data", "reset_action_recommended"]
    },
    "search": {
      "definition": "按关键词查找记录。",
      "allowedComponents": ["antd.input"],
      "preferredVariants": { "antd.input": { "intent": "search" } }
    },
    "bulk_action": {
      "definition": "对多条选中记录批量执行动作。",
      "allowedComponents": ["antd.button"],
      "rules": ["bulk_destructive_requires_confirmation", "bulk_action_bar_appears_when_selection_exists"]
    },
    "empty_state": {
      "definition": "解释内容缺失并引导下一步。",
      "allowedComponents": ["antd.typography", "antd.button"],
      "rules": ["empty_state_not_error", "must_offer_reset_or_primary_action"]
    },
    "status_display": {
      "definition": "紧凑表达记录/对象的状态、分类或计数。",
      "allowedComponents": ["antd.tag", "antd.badge"],
      "preferredVariants": {},
      "rules": ["status_color_must_be_semantic_not_arbitrary", "use_tag_for_category_badge_for_count"]
    },
    "toggle": {
      "definition": "在两个互斥状态间切换（开/关、启用/禁用）。",
      "allowedComponents": ["antd.switch"],
      "rules": ["must_have_accessible_label", "immediate_effect_should_confirm"]
    },
    "feedback": {
      "definition": "向用户传达系统状态/结果（提示、告警、错误）。",
      "allowedComponents": ["antd.alert"],
      "rules": ["error_feedback_must_be_actionable_or_correctable", "not_use_alert_for_no_data"]
    },
    "content": {
      "definition": "结构化文本（标题、说明、正文）。",
      "allowedComponents": ["antd.typography"],
      "preferredVariants": { "antd.typography": { "variant": "default" } }
    },
    "section": {
      "definition": "页面布局容器与分区。",
      "allowedComponents": ["antd.layout"],
      "rules": ["layout_must_use_registered_layout_components"]
    }
  }
}
