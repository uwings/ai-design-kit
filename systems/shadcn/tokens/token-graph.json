{
  "schemaVersion": "0.1",
  "system": "shadcn",
  "modes": [
    "light",
    "dark"
  ],
  "defaultMode": "light",
  "tokens": {
    "background": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "0 0% 100%",
        "dark": "240 10% 3.9%"
      },
      "description": "shadcn --background (HSL)"
    },
    "foreground": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "240 10% 3.9%",
        "dark": "0 0% 98%"
      },
      "description": "shadcn --foreground"
    },
    "primary": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "240 5.9% 10%",
        "dark": "0 0% 98%"
      },
      "description": "shadcn --primary（主操作色；改此即整体换主色）"
    },
    "primary-foreground": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "0 0% 98%",
        "dark": "240 5.9% 10%"
      }
    },
    "muted": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "240 4.8% 95.9%",
        "dark": "240 3.7% 15.9%"
      }
    },
    "muted-foreground": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "240 3.8% 46.1%",
        "dark": "240 5% 64.9%"
      }
    },
    "border": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "240 5.9% 90%",
        "dark": "240 3.7% 15.9%"
      }
    },
    "ring": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "240 5.9% 10%",
        "dark": "240 4.9% 83.9%"
      }
    },
    "radius": {
      "type": "number",
      "level": "semantic",
      "value": 0.5,
      "description": "shadcn --radius（rem）"
    },
    "destructive": {
      "type": "color",
      "level": "semantic",
      "modes": {
        "light": "0 72.2% 50.6%",
        "dark": "0 72.2% 50.6%"
      }
    }
  },
  "bindings": {
    "primary": [
      "shadcn.button:root.fill"
    ],
    "primary-foreground": [
      "shadcn.button:label.fill"
    ],
    "background": [
      "shadcn.card:root.fill",
      "shadcn.input:root.fill"
    ],
    "border": [
      "shadcn.card:root.stroke",
      "shadcn.input:root.stroke"
    ]
  }
}
