{
  "primary_action": {
    "definition": "当前局部决策上下文中，最希望用户采取的动作。",
    "components": [
      "antd.button"
    ],
    "patterns": [
      "admin-user-permissions",
      "destructive-confirmation"
    ],
    "preferredVariants": {
      "antd.button": {
        "intent": "primary"
      }
    },
    "riskLevel": "low"
  },
  "secondary_action": {
    "definition": "支持主路径、但不应在视觉上与主 CTA 竞争的动作。",
    "components": [
      "antd.button"
    ],
    "patterns": [],
    "preferredVariants": {
      "antd.button": {
        "intent": "default"
      }
    },
    "riskLevel": "none"
  },
  "destructive_action": {
    "definition": "删除、撤销、移除或造成不可逆/高风险变化的动作。",
    "components": [
      "antd.button"
    ],
    "patterns": [
      "destructive-confirmation"
    ],
    "preferredVariants": {
      "antd.button": {
        "intent": "danger"
      }
    },
    "riskLevel": "high"
  },
  "destructive_confirmation": {
    "definition": "破坏性操作执行前，阻断式要求用户二次确认的交互。",
    "components": [
      "antd.modal",
      "antd.button"
    ],
    "patterns": [
      "admin-user-permissions",
      "destructive-confirmation"
    ],
    "preferredVariants": {
      "antd.modal": {
        "intent": "confirm"
      },
      "antd.button": {
        "intent": "danger"
      }
    },
    "riskLevel": "high"
  },
  "navigation": {
    "definition": "在信息架构间移动（页面/视图/锚点），非触发业务动作。",
    "components": [
      "antd.menu",
      "antd.breadcrumb"
